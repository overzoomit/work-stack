{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work",
  "version": "../package.json",
  "identifier": "it.overzoom.work",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Terminali, git e agenti AI in un'unica dashboard",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    }
  }
}

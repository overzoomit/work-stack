{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work",
  "version": "../package.json",
  "identifier": "it.overzoom.work",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": []
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCM0U1RDNENTYyRTREMTUKUldRVlRTNVdQVjArbXhMc3hicmJxM0xhaWJoRkJKODdUeU1MSU5SVWJhY0M0UFVyMWxKUmlhZUcK",
      "endpoints": ["https://github.com/overzoomit/work-stack/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Terminali, git e agenti AI in un'unica dashboard",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    }
  }
}

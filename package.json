{
  "name": "work",
  "productName": "Work",
  "version": "2.19.0",
  "description": "Work — terminali, git e agenti in un'unica dashboard",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:e2e": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "npm run build:e2e && node --test \"test/e2e/*.e2e.mjs\"",
    "install:linux": "scripts/install-linux.sh",
    "test": "node --test \"test/*.test.{js,mjs}\" && cargo test --manifest-path src-tauri/Cargo.toml",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "postinstall": "node scripts/vendor.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0"
  }
}
